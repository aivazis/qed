// code guard
#pragma once


// clear the marks
template <typename gridT>
auto
qed::native::zeroNonFinite(gridT & region) -> void
{
    // go through the cells
    for (auto idx : region.packing()) {
        // get the cell
        auto & cell = region[idx];
        // and if it is a mark rather than a measurement
        if (!std::isfinite(cell.real()) || !std::isfinite(cell.imag())) {
            // it contributes nothing
            cell = 0;
        }
    }
    // all done
    return;
}


