// code guard
#pragma once


// my declarations
#include "Screen.h"


// simulate my c++ declaration
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Screen<ruleT, maskT, colorT>::declSelf() -> string_type
{
    // the type alias of my reading of the mask, with the declarations of my slots
    return rule_type::screen() + "<" + mask_type::declSelf() + ", " + color_type::declSelf() + ">";
}


// the human readable form of my class name
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Screen<ruleT, maskT, colorT>::className() -> string_type
{
    // my kind
    return "Screen";
}


// the descriptions of my slots
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Screen<ruleT, maskT, colorT>::declSlots() -> const slots_type &
{
    // my slots, in the order i declare them
    static const slots_type table {
        slot_type::input<mask_type>("mask"),          slot_type::input<color_type>("red"),
        slot_type::input<color_type>("green"),        slot_type::input<color_type>("blue"),
        slot_type::output<color_type>("paintedRed"),  slot_type::output<color_type>("paintedGreen"),
        slot_type::output<color_type>("paintedBlue"),
    };
    // hand them off
    return table;
}


// the descriptions of my settings
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Screen<ruleT, maskT, colorT>::declSettings() -> const settings_type &
{
    // i have none
    static const settings_type table {};
    // hand them off
    return table;
}


// the descriptions of my slots
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Screen<ruleT, maskT, colorT>::slots() const -> const slots_type &
{
    // the ones of my type
    return declSlots();
}


// the descriptions of my settings
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Screen<ruleT, maskT, colorT>::settings() const -> const settings_type &
{
    // the ones of my type
    return declSettings();
}


// factory
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Screen<ruleT, maskT, colorT>::create(const name_type & name) -> factory_ref_type
{
    // build an instance and wrap it in a shared pointer
    auto ref = std::make_shared<Screen>(sentinel_type(), name);
    // hand it off
    return ref;
}


// destructor
template <class ruleT, class maskT, class colorT>
qed::nisar::flow::Screen<ruleT, maskT, colorT>::~Screen()
{}


// constructor
template <class ruleT, class maskT, class colorT>
qed::nisar::flow::Screen<ruleT, maskT, colorT>::Screen(
    sentinel_type sentinel, const name_type & name) :
    // superclass
    super_type(sentinel, name)
{}


// the product bound to my {mask} slot
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Screen<ruleT, maskT, colorT>::mask() -> mask_ref_type
{
    // look it up and cast it to its type
    return std::dynamic_pointer_cast<mask_type>(input("mask"));
}


// the product bound to my {red} slot
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Screen<ruleT, maskT, colorT>::red() -> color_ref_type
