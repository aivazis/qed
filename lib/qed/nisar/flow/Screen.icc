// recolor the cells the mask flags
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Screen<ruleT, maskT, colorT>::make(
    const name_type & slot, super_type::product_ref_type product) -> super_type::factory_ref_type
{
    // chain up
    auto self = super_type::make(slot, product);
    // the mask
    auto screen = mask();
    // its cells
    const auto & codes = screen->read();
    // the colors the pipeline gave the cells
    const auto & r = red()->read();
    const auto & g = green()->read();
    const auto & b = blue()->read();
    // the products i paint
    auto painted = std::array { paintedRed(), paintedGreen(), paintedBlue() };
    // the colors i paint them
    auto & pr = painted[0]->write();
    auto & pg = painted[1]->write();
    auto & pb = painted[2]->write();
    // the number of cells
    const auto pixels = screen->shape().cells();
    // go through them
    for (auto pixel = 0; pixel < pixels; ++pixel) {
        // ask the rule what the mask makes of the cell
        const auto paint = rule_type::paint(codes[pixel]);
        // pick the color of the cell: the one the mask imposes, or the one the pipeline chose
        const auto color = paint.value_or(
            rgb_type { static_cast<float>(r[pixel]), static_cast<float>(g[pixel]),
                       static_cast<float>(b[pixel]) });
        // paint it
        pr[pixel] = color.red;
        pg[pixel] = color.green;
        pb[pixel] = color.blue;
    }
    // the colors are fresh
    for (auto & channel : painted) {
        // one at a time
        channel->clean();
    }
    // all done
    return self;
}


