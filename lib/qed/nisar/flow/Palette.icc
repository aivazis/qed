// code guard
#pragma once


// my declarations
#include "Palette.h"


// simulate my c++ declaration
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Palette<ruleT, maskT, colorT>::declSelf() -> string_type
{
    // the type alias of my reading of the mask, with the declarations of my slots
    return rule_type::colormap() + "<" + mask_type::declSelf() + ", " + color_type::declSelf()
         + ">";
}


// the human readable form of my class name
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Palette<ruleT, maskT, colorT>::className() -> string_type
{
    // my kind
    return "Palette";
}


// the descriptions of my slots
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Palette<ruleT, maskT, colorT>::declSlots() -> const slots_type &
{
    // my slots, in the order i declare them
    static const slots_type table {
        slot_type::input<mask_type>("mask"),
        slot_type::output<color_type>("red"),
        slot_type::output<color_type>("green"),
        slot_type::output<color_type>("blue"),
    };
    // hand them off
    return table;
}


// the descriptions of my settings
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Palette<ruleT, maskT, colorT>::declSettings() -> const settings_type &
{
    // i have none
    static const settings_type table {};
    // hand them off
    return table;
}


// the descriptions of my slots
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Palette<ruleT, maskT, colorT>::slots() const -> const slots_type &
{
    // the ones of my type
    return declSlots();
}


// the descriptions of my settings
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Palette<ruleT, maskT, colorT>::settings() const -> const settings_type &
{
    // the ones of my type
    return declSettings();
}


// factory
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Palette<ruleT, maskT, colorT>::create(const name_type & name) -> factory_ref_type
{
    // build an instance and wrap it in a shared pointer
    auto ref = std::make_shared<Palette>(sentinel_type(), name);
    // hand it off
    return ref;
}


// destructor
template <class ruleT, class maskT, class colorT>
qed::nisar::flow::Palette<ruleT, maskT, colorT>::~Palette()
{}


// constructor
template <class ruleT, class maskT, class colorT>
qed::nisar::flow::Palette<ruleT, maskT, colorT>::Palette(
    sentinel_type sentinel, const name_type & name) :
    // superclass
    super_type(sentinel, name)
{}


// the product bound to my {mask} slot
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Palette<ruleT, maskT, colorT>::mask() -> mask_ref_type
{
    // look it up and cast it to its type
    return std::dynamic_pointer_cast<mask_type>(input("mask"));
}


// the product bound to my {red} slot
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Palette<ruleT, maskT, colorT>::red() -> color_ref_type
{
    // look it up and cast it to its type
    return std::dynamic_pointer_cast<color_type>(output("red"));
}


// the product bound to my {green} slot
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Palette<ruleT, maskT, colorT>::green() -> color_ref_type
{
    // look it up and cast it to its type
    return std::dynamic_pointer_cast<color_type>(output("green"));
}


// the product bound to my {blue} slot
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Palette<ruleT, maskT, colorT>::blue() -> color_ref_type
{
    // look it up and cast it to its type
    return std::dynamic_pointer_cast<color_type>(output("blue"));
}


// color the codes of the mask
template <class ruleT, class maskT, class colorT>
auto
qed::nisar::flow::Palette<ruleT, maskT, colorT>::make(
    const name_type & slot, super_type::product_ref_type product) -> super_type::factory_ref_type
{
    // chain up
    auto self = super_type::make(slot, product);
    // the mask
    auto codes = mask();
    // its cells
    const auto & cells = codes->read();
    // the colors of the codes
    const auto & palette = rule_type::palette();
    // the products i make
    auto colors = std::array { red(), green(), blue() };
    // and their cells
    auto & r = colors[0]->write();
    auto & g = colors[1]->write();
    auto & b = colors[2]->write();
    // the number of cells
    const auto pixels = codes->shape().cells();
    // go through them
    for (auto pixel = 0; pixel < pixels; ++pixel) {
        // look up the color of the code in the low byte, the way the mask kernels do
        const auto & color = palette[cells[pixel] & 0xff];
        // and paint the cell
        r[pixel] = color.red;
        g[pixel] = color.green;
        b[pixel] = color.blue;
    }
    // the colors are fresh
    for (auto & channel : colors) {
        // one at a time
        channel->clean();
    }
    // all done
    return self;
}


