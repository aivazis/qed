// code guard
#pragma once

// the gather and the deposit that know both kinds of raster
#include "fetch.h"
// my declaration
#include "pyramid.h"


// build a tile of a pyramid level by decimating the level below it
template <typename sourceT, typename rasterT, typename draftT>
auto
qed::nisar::decimate(
    // the level being read
    const rasterT & source,
    // the level being written
    draftT & destination,
    // the data layout, shared by both
    const datatype_t & datatype,
    // the origin of the tile, in the coordinates of the destination
    typename sourceT::index_type origin,
    // the shape of the tile, in the coordinates of the destination
    typename sourceT::shape_type tile,
    // the decimation, applied to the source
    typename sourceT::index_type stride) -> native::sample_t
{
    // the region of the source this tile covers starts at the destination origin scaled by
    // the decimation; go through the axes
    auto from = origin;
    // and scale each one
    for (int axis = 0; axis < decltype(from)::rank(); ++axis) {
        // by the stride, since one destination cell stands for {stride} source cells
        from[axis] *= stride[axis];
    }

    // gather the strided tile; whichever kind of raster the source is, what comes back is
    // dense in memory and already the shape of the destination tile
    auto data = fetch<sourceT>(source, datatype, from, tile, stride);

    // measure what the tile holds. every cell of it is in hand already, so the statistics
    // of the level, and through it of the whole raster, cost nothing beyond the arithmetic
    auto measured = native::sample(data, { 0, 0 }, tile, decltype(stride)::one());
    // the count comes first in the record
    auto cells = std::get<0>(measured);
    // a geocoded product frames its data inside a much larger grid of fill, and the
    // library does not allocate a chunk nobody writes; writing a tile of pure fill would
    // therefore turn a sparse product into a dense one, which costs both the space and the
    // time to compress it. so if this tile holds nothing
    if (cells == 0) {
        // leave the destination chunk unallocated; it reads back as fill, which is what
        // the tile held anyway
        return measured;
    }

    // deposit it where the destination keeps this tile
    deposit(destination, datatype, origin, data);
    // report what the tile held
    return measured;
}


// end of file
