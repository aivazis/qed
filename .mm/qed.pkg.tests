# the test suite for the qed package
qed.pkg.tests.stem := qed.pkg
# depends on
qed.pkg.tests.prerequisites := qed.pkg qed.ext

# the CEOS driver writes its own image files, and the flat references it compares them to
tests.qed.pkg.ceos.clean := \
    ceos_alos.dat ceos_sgf.dat ceos_asf.dat ceos_real.dat ceos_bsq.dat ceos_bil.dat \
    ceos_vary.dat ceos_cint.dat ceos_flat.dat ceos_alos_reference.dat ceos_sgf_reference.dat \
    ceos_asf_reference.dat ceos_real_reference.dat ceos_bsq0_reference.dat \
    ceos_bsq1_reference.dat ceos_bil0_reference.dat ceos_bil1_reference.dat

# the ENVI driver writes its own products and headers
tests.qed.pkg.envi.clean := \
    envi_le.dat envi_le.hdr envi_readonly.dat envi_readonly.hdr envi_be.dat envi_be.dat.hdr \
    envi_offset_short.dat envi_offset_short.hdr envi_offset_128_0.dat envi_offset_128_0.hdr \
    envi_offset_128_1.dat envi_offset_128_1.hdr envi_offset_3_0.dat envi_offset_3_0.hdr \
    envi_offset_3_1.dat envi_offset_3_1.hdr envi_offset_6_0.dat envi_offset_6_0.hdr \
    envi_offset_6_1.dat envi_offset_6_1.hdr envi_band0_0.dat envi_band1_0.dat envi_band2_0.dat \
    envi_bsq_0.dat envi_bsq_0.hdr envi_bil_0.dat envi_bil_0.hdr envi_bip_0.dat envi_bip_0.hdr \
    envi_band0_5.dat envi_band1_5.dat envi_band2_5.dat envi_bsq_5.dat envi_bsq_5.hdr \
    envi_bil_5.dat envi_bil_5.hdr envi_bip_5.dat envi_bip_5.hdr

# the persistence drivers share a scratch workspace: the reboot reads what the first wrote
tests.qed.pkg.persist.clean := persist_ws
tests.qed.pkg.browse.clean := browse_ws
tests.qed.pkg.archive_symlink.clean := archive_symlink_ws archive_symlink_link
tests.qed.pkg.browse_fleet.clean := browse_fleet_ws
# the drivers below clear their workspace when they start and leave it behind for inspection
tests.qed.pkg.archive_restore.clean := archive_restore_ws
tests.qed.pkg.persist_archive.clean := persist_archive_ws
tests.qed.pkg.persist_empty.clean := persist_empty_ws
tests.qed.pkg.persist_reader.clean := persist_reader_ws
tests.qed.pkg.persist_coupled.clean := persist_coupled_ws
# the seed driver writes the unwrapped product it measures
tests.qed.pkg.measured.clean := measured.unw
tests.qed.pkg.sample_isce2.clean := sample.unw sample.int
# the coupling driver writes a small wrapped interferogram
tests.qed.pkg.coupled.clean := coupled.int
tests.qed.pkg.persist_reboot.pre := tests.qed.pkg.persist
# the pyramid builders leave their scratch areas behind for inspection
tests.qed.pkg.build.clean := build.scratch build.alone
tests.qed.pkg.build_joint.clean := build_joint.alone build_joint.joint
tests.qed.pkg.build_levels.clean := build_levels.scratch
tests.qed.pkg.graphql_workspace.clean := graphql_workspace.scratch
# the pyramid driver also asks the default workspace for its cache, in the current directory
tests.qed.pkg.pyramid.clean := pyramid.scratch .qed
# the drivers below keep their fixtures and products in a folder of their own
tests.qed.pkg.census_reference.clean := census_reference.scratch
tests.qed.pkg.measurements_census.clean := measurements_census.scratch
tests.qed.pkg.measurements_scrape.clean := measurements_scrape.scratch
# the statistics driver writes an all-zero raster
tests.qed.pkg.constant.clean := constant_zeros.dat


# end of file
