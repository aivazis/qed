# configuration for libqed
qed.lib.stem := qed
qed.lib.root := lib/qed/

# qed depends on fftw and pyre
qed.lib.extern := fftw pyre

# use c++20
qed.lib.c++.flags += $($(compiler.c++).std.c++20)

# the autogen files
qed.lib.headers.autogen := version.h.in
# the expansion table
qed.lib.autogen = \
    @MAJOR@|$(qed.major)\
    @MINOR@|$(qed.minor) \
    @MICRO@|$(qed.micro) \
    @REVISION@|$(qed.revision) \

# the transforms run in single precision, like the complex samples of the SLC products
fftw.flavor := 3f


# end of file
