# the testsuite for the qed bindings
qed.ext.tests.stem := qed.ext
# depends on
qed.ext.tests.prerequisites := qed.pkg qed.ext
# external dependencies
qed.ext.tests.extern := $(qed.ext.extern)

# the pyramid driver writes two levels and their occupancy records
tests.qed.ext.pyramid.clean := pyramid.tiles pyramid.occupancy above.tiles above.occupancy


# end of file
