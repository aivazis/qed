# the testsuite for the qed library
qed.lib.tests.stem := qed.lib
# depends on
qed.lib.tests.prerequisites := qed.lib
# the drivers compile the way the library does, so they see the same language standard
qed.lib.tests.c++.flags += $(qed.lib.c++.flags)
# external dependencies
qed.lib.tests.extern := $(qed.lib.extern)

# each generator emits its fixture beside itself; record the outputs for the clean rules
tests.qed.lib.nisar.masks.gcov.clean += gcov.bmp
tests.qed.lib.nisar.masks.gunw.clean += gunw.bmp
tests.qed.lib.native.fft.clean += \
    fft-wave.bmp fft-between.bmp fft-between-hann.bmp fft-noise.bmp fft-slc.bmp


# end of file
